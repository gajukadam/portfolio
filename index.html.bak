<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gajanan Sanjay Kadam | Second-Year CSE Student | SSGMCE Shegaon</title>
  <meta name="description" content="Personal Portfolio of Gajanan Sanjay Kadam - Second-Year Computer Science and Engineering Student at SSGMCE Shegaon (Ex-Navodayan). Cyber Sunset Orange & Hot Pink Edition for ARISE Diwali Portfolio Competition 2026." />

  <!-- Google Fonts: Space Grotesk, Inter, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Centralized Portfolio Configuration (Source of Truth) -->
  <script src="portfolio-data.js"></script>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            display: ['"Space Grotesk"', 'Inter', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            dark: {
              bg: '#0B0410',
              card: '#140A1F',
              surface: '#1A0D28',
              border: 'rgba(255, 107, 53, 0.2)',
            },
            sunset: {
              400: '#FF8A50',
              500: '#FF6B35', // Bold Electric Orange
              600: '#FF5722',
              glow: 'rgba(255, 107, 53, 0.4)',
            },
            cyberpink: {
              400: '#FF5C9D',
              500: '#FF2A85', // Bold Electric Hot Pink
              600: '#E11D48',
              glow: 'rgba(255, 42, 133, 0.4)',
            },
            amber: {
              400: '#FBBF24',
              500: '#FFAE33',
            }
          },
          animation: {
            'spin-slow': 'spin 20s linear infinite',
            'spin-reverse': 'spinReverse 25s linear infinite',
            'pulse-subtle': 'pulseSubtle 3.5s ease-in-out infinite',
            'float-slow': 'floatSlow 5s ease-in-out infinite',
            'float-delayed': 'floatSlow 5.5s ease-in-out 2s infinite',
            'fade-in': 'fadeIn 0.35s ease-out forwards',
            'gradient-x': 'gradientX 6s ease infinite',
          },
          keyframes: {
            spinReverse: {
              '0%': { transform: 'rotate(360deg)' },
              '100%': { transform: 'rotate(0deg)' },
            },
            floatSlow: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-7px)' },
            },
            pulseSubtle: {
              '0%, 100%': { opacity: '0.45', transform: 'scale(1)' },
              '50%': { opacity: '0.8', transform: 'scale(1.03)' },
            },
            fadeIn: {
              '0%': { opacity: '0', transform: 'translateY(10px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            },
            gradientX: {
              '0%, 100%': { 'background-size': '200% 200%', 'background-position': 'left center' },
              '50%': { 'background-size': '200% 200%', 'background-position': 'right center' }
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* Custom Scrollbar - Bold Sunset Orange & Cyber Pink */
    ::-webkit-scrollbar {
      width: 9px;
    }
    ::-webkit-scrollbar-track {
      background: #0B0410;
    }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #FF6B35, #FF2A85);
      border-radius: 5px;
      border: 2px solid #0B0410;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #FF2A85;
    }

    /* Cosmic Grid Motif */
    .bg-cyber-grid {
      background-image: 
        linear-gradient(to right, rgba(255, 107, 53, 0.08) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 42, 133, 0.08) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Aesthetic Glass Card with Gradient Border on Hover */
    .aesthetic-card {
      background: rgba(20, 10, 31, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 107, 53, 0.22);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .aesthetic-card:hover {
      border-color: rgba(255, 42, 133, 0.6);
      box-shadow: 0 16px 40px -10px rgba(255, 42, 133, 0.22), 0 0 20px rgba(255, 107, 53, 0.15);
      transform: translateY(-3px);
    }

    /* Bold Gradient Text */
    .gradient-text {
      background: linear-gradient(135deg, #FF8A50 0%, #FF6B35 25%, #FF2A85 75%, #FFAE33 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Glowing Button */
    .btn-sunset {
      background: linear-gradient(135deg, #FF6B35 0%, #FF2A85 100%);
      color: #FFFFFF;
      box-shadow: 0 0 25px rgba(255, 107, 53, 0.35);
      transition: all 0.25s ease;
    }
    .btn-sunset:hover {
      box-shadow: 0 0 35px rgba(255, 42, 133, 0.6);
      transform: scale(1.03);
    }

    /* Nav Tab Active Indicator */
    .nav-tab.active {
      background: linear-gradient(135deg, rgba(255, 107, 53, 0.2) 0%, rgba(255, 42, 133, 0.2) 100%);
      color: #FFFFFF;
      border: 1px solid rgba(255, 42, 133, 0.5);
      box-shadow: 0 0 15px rgba(255, 42, 133, 0.25);
    }

    /* Animated Glowing Diya Flame */
    @keyframes diyaFlicker {
      0%, 100% { transform: scale(1) rotate(-1deg); filter: drop-shadow(0 0 6px #FF6B35); }
      50% { transform: scale(1.15) rotate(2deg); filter: drop-shadow(0 0 12px #FF2A85); }
    }
    .diya-flame {
      animation: diyaFlicker 2s ease-in-out infinite alternate;
    }
  </style>
</head>

<body class="bg-[#0B0410] text-[#FFFFFF] antialiased selection:bg-[#FF2A85] selection:text-white min-h-screen relative overflow-x-hidden">

  <!-- Interactive Constellation Spark Canvas -->
  <canvas id="spark-canvas" class="fixed inset-0 pointer-events-none z-0 opacity-60"></canvas>

  <!-- Ambient Glowing Aurora Orbs -->
  <div class="fixed top-[-100px] left-1/4 w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-[#FF6B35]/20 via-[#FF2A85]/20 to-transparent blur-[120px] pointer-events-none z-0"></div>
  <div class="fixed bottom-[-100px] right-10 w-[450px] h-[450px] rounded-full bg-gradient-to-br from-[#FF2A85]/15 via-[#FFAE33]/15 to-transparent blur-[130px] pointer-events-none z-0"></div>

  <div class="relative z-10 flex flex-col min-h-screen">

    <!-- ========================================================================= -->
    <!-- TOP COMPETITION & DIWALI 2026 FESTIVE BANNER                             -->
    <!-- ========================================================================= -->
    <header class="bg-gradient-to-r from-[#170824] via-[#240C33] to-[#170824] border-b border-[#FF6B35]/30 text-white text-xs font-mono py-2.5 px-4 sticky top-0 z-50 shadow-lg">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <!-- Festive Animated Diya Icon -->
          <span class="diya-flame text-base inline-block">🪔</span>
          <span class="px-2 py-0.5 rounded-full bg-gradient-to-r from-[#FF6B35] to-[#FF2A85] text-[10px] font-bold tracking-wide uppercase text-white shadow-sm">
            ARISE Diwali 2026
          </span>
          <span class="text-[#FF8A50] font-medium hidden sm:inline">•</span>
          <span class="text-[#D1C4E9] hidden sm:inline">
            Diwali Portfolio Competition • <span class="text-white font-semibold">SSGMCE, Shegaon</span>
          </span>
        </div>
        
        <div class="flex items-center gap-3 text-[11px] text-[#C4B5CD]">
          <span class="flex items-center gap-1 text-[#FFAE33]">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-[#FFAE33] animate-pulse"></i>
            <span class="font-bold text-white">AI-Engineered</span>
          </span>
          <span class="text-white/20">|</span>
          <button onclick="openAIArchitectureModal()" class="text-[#FF5C9D] hover:text-[#FFAE33] underline underline-offset-2 flex items-center gap-1 transition-colors">
            <span>Judge Inspection</span>
            <i data-lucide="external-link" class="w-3 h-3"></i>
          </button>
          <span class="text-white/20 hidden md:inline">|</span>
          <span class="text-white/70 hidden md:inline">Final Deadline: 14 Nov 2026</span>
        </div>
      </div>
    </header>

    <!-- ========================================================================= -->
    <!-- GLOBAL NAVIGATION BAR (Multi-Page Route Controller)                      -->
    <!-- ========================================================================= -->
    <nav class="sticky top-[41px] z-40 bg-[#0B0410]/90 backdrop-blur-xl border-b border-[#FF6B35]/20 shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Brand Identity / Home Trigger -->
        <a href="#/" onclick="navigateTo('home', event)" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#FF6B35] via-[#FF2A85] to-[#FFAE33] text-white flex items-center justify-center font-display font-extrabold text-sm tracking-tight shadow-[0_0_15px_rgba(255,42,133,0.4)] group-hover:scale-105 transition-all">
            <span id="nav-initials">GK</span>
          </div>
          <div class="flex flex-col">
            <span class="text-base font-bold text-white tracking-tight group-hover:text-[#FF8A50] transition-colors font-display" id="nav-name">
              Gajanan Sanjay Kadam
            </span>
            <span class="text-[10px] font-mono text-[#FF5C9D] tracking-wide flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B35] animate-ping"></span>
              2nd Year CSE • SSGMCE
            </span>
          </div>
        </a>

        <!-- Desktop Multi-Page Nav Links -->
        <div class="hidden md:flex items-center gap-1 bg-[#140A1F]/90 p-1.5 rounded-2xl border border-white/10 shadow-inner">
          <a href="#/" onclick="navigateTo('home', event)" class="nav-tab active px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium text-[#C4B5CD] hover:text-white transition-all" data-page="home">
            Home
          </a>
          <a href="#/about" onclick="navigateTo('about', event)" class="nav-tab px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium text-[#C4B5CD] hover:text-white transition-all" data-page="about">
            About Me
          </a>
          <a href="#/skills" onclick="navigateTo('skills', event)" class="nav-tab px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium text-[#C4B5CD] hover:text-white transition-all" data-page="skills">
            Skills
          </a>
          <a href="#/projects" onclick="navigateTo('projects', event)" class="nav-tab px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium text-[#C4B5CD] hover:text-white transition-all" data-page="projects">
            Projects
          </a>
          <a href="#/education" onclick="navigateTo('education', event)" class="nav-tab px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium text-[#C4B5CD] hover:text-white transition-all" data-page="education">
            Education
          </a>
          <a href="#/achievements" onclick="navigateTo('achievements', event)" class="nav-tab px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium text-[#C4B5CD] hover:text-white transition-all" data-page="achievements">
            Achievements
          </a>
          <a href="#/contact" onclick="navigateTo('contact', event)" class="nav-tab px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium text-[#C4B5CD] hover:text-white transition-all" data-page="contact">
            Contact
          </a>
        </div>

        <!-- Quick CTAs: Resume & Contact -->
        <div class="hidden md:flex items-center gap-2.5">
          <button onclick="openResumeModal()" class="px-3 py-1.5 rounded-xl bg-white/5 border border-white/15 text-[#FFAE33] hover:border-[#FFAE33] hover:bg-[#FFAE33]/10 text-xs font-mono font-semibold transition-all flex items-center gap-1.5 shadow-sm">
            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
            <span>Resume</span>
          </button>
          <a href="#/contact" onclick="navigateTo('contact', event)" class="btn-sunset px-4 py-1.5 rounded-xl text-xs font-mono font-bold tracking-tight shadow-md flex items-center gap-1.5">
            <span>Get in Touch</span>
            <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
          </a>
        </div>

        <!-- Mobile Hamburger Toggle -->
        <div class="flex items-center gap-2 md:hidden">
          <button onclick="openResumeModal()" class="p-2 rounded-xl bg-white/5 border border-white/10 text-[#FFAE33] text-xs">
            <i data-lucide="file-text" class="w-4 h-4"></i>
          </button>
          <button id="mobile-menu-btn" class="p-2 rounded-xl bg-[#140A1F] border border-white/15 text-[#D1C4E9] hover:text-white hover:border-[#FF2A85] transition-colors" aria-label="Toggle navigation menu" aria-expanded="false">
            <i data-lucide="menu" class="w-5 h-5"></i>
          </button>
        </div>

      </div>

      <!-- Mobile Dropdown Navigation -->
      <div id="mobile-menu" class="hidden md:hidden bg-[#0F0617] border-b border-[#FF6B35]/30 px-4 py-4 space-y-2 shadow-2xl">
        <a href="#/" onclick="navigateTo('home', event); toggleMobileMenu(false);" class="mobile-nav-link block px-3 py-2 rounded-xl text-sm font-mono text-[#D1C4E9] hover:text-white hover:bg-white/5" data-page="home">
          01. Home
        </a>
        <a href="#/about" onclick="navigateTo('about', event); toggleMobileMenu(false);" class="mobile-nav-link block px-3 py-2 rounded-xl text-sm font-mono text-[#D1C4E9] hover:text-white hover:bg-white/5" data-page="about">
          02. About Me
        </a>
        <a href="#/skills" onclick="navigateTo('skills', event); toggleMobileMenu(false);" class="mobile-nav-link block px-3 py-2 rounded-xl text-sm font-mono text-[#D1C4E9] hover:text-white hover:bg-white/5" data-page="skills">
          03. Skills
        </a>
        <a href="#/projects" onclick="navigateTo('projects', event); toggleMobileMenu(false);" class="mobile-nav-link block px-3 py-2 rounded-xl text-sm font-mono text-[#D1C4E9] hover:text-white hover:bg-white/5" data-page="projects">
          04. Projects
        </a>
        <a href="#/education" onclick="navigateTo('education', event); toggleMobileMenu(false);" class="mobile-nav-link block px-3 py-2 rounded-xl text-sm font-mono text-[#D1C4E9] hover:text-white hover:bg-white/5" data-page="education">
          05. Education
        </a>
        <a href="#/achievements" onclick="navigateTo('achievements', event); toggleMobileMenu(false);" class="mobile-nav-link block px-3 py-2 rounded-xl text-sm font-mono text-[#D1C4E9] hover:text-white hover:bg-white/5" data-page="achievements">
          06. Achievements
        </a>
        <a href="#/contact" onclick="navigateTo('contact', event); toggleMobileMenu(false);" class="mobile-nav-link block px-3 py-2 rounded-xl text-sm font-mono text-[#D1C4E9] hover:text-white hover:bg-white/5" data-page="contact">
          07. Contact
        </a>
        <div class="pt-2 border-t border-white/10 flex gap-2">
          <button onclick="openResumeModal(); toggleMobileMenu(false);" class="flex-1 py-2 rounded-xl bg-white/5 border border-white/15 text-xs font-mono text-[#FFAE33] flex items-center justify-center gap-1.5">
            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
            <span>Resume</span>
          </button>
          <a href="#/contact" onclick="navigateTo('contact', event); toggleMobileMenu(false);" class="flex-1 py-2 rounded-xl btn-sunset text-xs font-mono font-bold text-center">
            Contact Me
          </a>
        </div>
      </div>
    </nav>

    <!-- ========================================================================= -->
    <!-- MAIN CONTENT VIEW CONTAINER (SPA Target Pages)                           -->
    <!-- ========================================================================= -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

      <!-- ======================================================================= -->
      <!-- PAGE 1: HOME (Hero + Quick Highlights + Featured Teaser)                -->
      <!-- ======================================================================= -->
      <section id="page-home" class="space-y-16 animate-fade-in">
        
        <!-- Hero Two-Column Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center pt-2 pb-6">
          
          <!-- Left Column: Expressive Typography & Pitch -->
          <div class="lg:col-span-7 space-y-6">
            
            <!-- Badges Bar -->
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-[#FF6B35]/20 to-[#FF2A85]/20 border border-[#FF6B35]/40 text-[#FFAE33] text-xs font-mono font-semibold shadow-sm">
                <span class="w-2 h-2 rounded-full bg-[#FF6B35] animate-ping"></span>
                <span>Second-Year CSE Undergraduate</span>
              </span>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[#C4B5CD] text-xs font-mono">
                <i data-lucide="award" class="w-3 h-3 text-[#FF5C9D]"></i>
                <span>Ex-Navodayan (JNV Parbhani)</span>
              </span>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[#C4B5CD] text-xs font-mono">
                <i data-lucide="map-pin" class="w-3 h-3 text-[#FF6B35]"></i>
                <span>SSGMCE, Shegaon</span>
              </span>
            </div>

            <!-- Main Name & Expressive Title -->
            <div class="space-y-2">
              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-display tracking-tight text-white leading-[1.1]">
                Hi, I'm <br class="sm:hidden" />
                <span class="gradient-text" id="hero-name">Gajanan Sanjay Kadam</span>
              </h1>
              
              <!-- Dynamic Word Rotator / Typing Effect -->
              <div class="h-8 flex items-center">
                <p class="text-lg sm:text-xl font-mono text-[#D1C4E9] font-medium flex items-center gap-2">
                  <span class="text-[#FF6B35]">&gt;</span>
                  <span id="hero-typewriter" class="text-white border-r-2 border-[#FF2A85] pr-1">Second-Year CSE Student @ SSGMCE</span>
                </p>
              </div>
            </div>

            <!-- Authentic Summary from Resume -->
            <p class="text-base sm:text-lg text-[#C4B5CD] leading-relaxed max-w-2xl font-sans" id="hero-desc">
              2nd-year Computer Science & Engineering student (Ex-Navodayan, JNV Parbhani) at SSGMCE Shegaon with a strong foundation in C programming, web development (HTML/CSS), and analytical problem solving. Seeking an entry-level technical role or fellowship to apply my skills, gain hands-on experience, and learn new technologies.
            </p>

            <!-- Action CTAs -->
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a href="#/projects" onclick="navigateTo('projects', event)" class="btn-sunset px-6 py-3 rounded-2xl text-sm font-mono font-bold tracking-tight shadow-xl flex items-center gap-2">
                <i data-lucide="layout" class="w-4 h-4"></i>
                <span>Explore Projects</span>
              </a>
              <button onclick="openResumeModal()" class="px-5 py-3 rounded-2xl bg-white/5 border border-white/20 text-[#FFAE33] hover:border-[#FFAE33] hover:bg-[#FFAE33]/10 text-sm font-mono font-semibold transition-all flex items-center gap-2 shadow-sm">
                <i data-lucide="file-text" class="w-4 h-4"></i>
                <span>View Resume</span>
              </button>
              <a href="#/contact" onclick="navigateTo('contact', event)" class="px-5 py-3 rounded-2xl bg-transparent border border-white/20 text-[#D1C4E9] hover:text-white hover:border-[#FF2A85] text-sm font-mono font-semibold transition-all flex items-center gap-2">
                <span>Contact Me</span>
              </a>
            </div>

            <!-- Key Metric Cards (Semester SGPA & Authentic Stats) -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10">
              <div class="p-3.5 rounded-2xl aesthetic-card">
                <div class="text-[10px] font-mono text-[#FFAE33] uppercase tracking-wider">[01] Semester 1 SGPA</div>
                <div class="text-lg font-bold text-white mt-0.5 font-display stat-counter" data-target="8.14" data-decimals="2">8.14 / 10</div>
                <div class="text-[11px] text-[#FF5C9D] font-mono">First Sem Result</div>
              </div>
              <div class="p-3.5 rounded-2xl aesthetic-card">
                <div class="text-[10px] font-mono text-[#FF8A50] uppercase tracking-wider">[02] Semester 2 SGPA</div>
                <div class="text-lg font-bold text-white mt-0.5 font-display stat-counter" data-target="8.32" data-decimals="2">8.32 / 10</div>
                <div class="text-[11px] text-[#FFAE33] font-mono">Second Sem Result</div>
              </div>
              <div class="p-3.5 rounded-2xl aesthetic-card">
                <div class="text-[10px] font-mono text-[#FFAE33] uppercase tracking-wider">[03] HSC (Science)</div>
                <div class="text-lg font-bold text-white mt-0.5 font-display stat-counter" data-target="83.5" data-decimals="1" data-suffix="%">83.5%</div>
                <div class="text-[11px] text-[#C4B5CD]">JNV Parbhani</div>
              </div>
              <div class="p-3.5 rounded-2xl aesthetic-card">
                <div class="text-[10px] font-mono text-[#FF8A50] uppercase tracking-wider">[04] Core Foundation</div>
                <div class="text-lg font-bold text-white mt-0.5 font-display">C & Core Java</div>
                <div class="text-[11px] text-[#FF5C9D]">OOP in Progress</div>
              </div>
            </div>

          </div>

          <!-- Right Column: Aesthetic Circular Profile Frame with Rotating Orbit Rings -->
          <div class="lg:col-span-5 flex justify-center items-center py-6">
            <div class="relative w-80 h-80 sm:w-96 sm:h-96 flex items-center justify-center select-none">
              
              <!-- Ambient Multi-Gradient Glow Behind Circle -->
              <div class="absolute inset-4 rounded-full bg-gradient-to-tr from-[#FF6B35]/40 via-[#FF2A85]/40 to-[#FFAE33]/30 blur-2xl animate-pulse-subtle pointer-events-none"></div>

              <!-- Outer Rotating Dashed Ring (Clockwise) -->
              <svg class="absolute inset-0 w-full h-full animate-spin-slow pointer-events-none" viewBox="0 0 400 400">
                <circle cx="200" cy="200" r="185" fill="none" stroke="url(#sunsetGradient)" stroke-width="2.5" stroke-dasharray="14 18" opacity="0.75" />
                <defs>
                  <linearGradient id="sunsetGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#FF6B35" />
                    <stop offset="50%" stop-color="#FF2A85" />
                    <stop offset="100%" stop-color="#FFAE33" />
                  </linearGradient>
