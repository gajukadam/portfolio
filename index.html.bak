        <div class="p-3 rounded-2xl bg-white/5 border border-white/10 space-y-1">
          <div class="text-[#FF8A50] font-bold">[1] Hybrid Client-Side SPA Engine</div>
          <div class="text-xs text-[#C4B5CD]">Engineered a zero-dependency multi-page architecture with 7 dedicated page views, browser back/forward history management, and seamless URL routing.</div>
        </div>

        <div class="p-3 rounded-2xl bg-white/5 border border-white/10 space-y-1">
          <div class="text-[#FF5C9D] font-bold">[2] Interactive HTML5 Particle Canvas</div>
          <div class="text-xs text-[#C4B5CD]">Simulates constellation physics with Sunset Orange and Neon Pink floating spark nodes with real-time mouse interaction.</div>
        </div>

        <div class="p-3 rounded-2xl bg-white/5 border border-white/10 space-y-1">
          <div class="text-[#FFAE33] font-bold">[3] Cyber Sunset Color Science</div>
          <div class="text-xs text-[#C4B5CD]">Departed from generic templates by combining bold Sunset Orange (#FF6B35) and Cyber Pink (#FF2A85) against Cosmic Obsidian (#0B0410).</div>
        </div>

        <div class="p-3 rounded-2xl bg-white/5 border border-white/10 space-y-1">
          <div class="text-[#FF8A50] font-bold">[4] 100% Authentic Resume Integrity</div>
          <div class="text-xs text-[#C4B5CD]">Directly mapped Gajanan Sanjay Kadam's verified resume (SSGMCE First Sem SGPA 8.14 / Second Sem SGPA 8.32, JNV Parbhani HSC 83.5%, C Language, Core Java & OOP, real projects) with zero fabricated credentials.</div>
        </div>
      </div>

      <div class="pt-2 text-right">
        <button onclick="closeAIArchitectureModal()" class="px-5 py-2 rounded-xl btn-sunset text-xs font-mono font-bold">
          Understood
        </button>
      </div>

    </div>
  </div>

  <!-- Centralized Data Script -->
  <script src="portfolio-data.js"></script>

  <!-- Application Logic, Multi-Page Router, Dynamic Typewriter, Spark Canvas -->
  <script>
    // -------------------------------------------------------------------------
    // 1. MULTI-PAGE CLIENT-SIDE ROUTER (SPA Engine)
    // -------------------------------------------------------------------------
    const validPages = ['home', 'about', 'skills', 'projects', 'education', 'achievements', 'contact'];

    function getRouteFromUrl() {
      const hash = window.location.hash.replace(/^#\/?/, '').toLowerCase().trim();
      if (validPages.includes(hash)) return hash;

      const path = window.location.pathname.replace(/^\/|\/$/g, '').toLowerCase().trim();
      if (validPages.includes(path)) return path;

      return 'home';
    }

    function navigateTo(page, event) {
      if (event && event.preventDefault) {
        event.preventDefault();
      }

      const targetPage = validPages.includes(page) ? page : 'home';

      // Hide all page views
      validPages.forEach(p => {
        const el = document.getElementById(`page-${p}`);
        if (el) el.classList.add('hidden');
      });

      // Show targeted page view
      const activeEl = document.getElementById(`page-${targetPage}`);
      if (activeEl) activeEl.classList.remove('hidden');

      // Update active nav indicators
      document.querySelectorAll('.nav-tab').forEach(tab => {
        if (tab.getAttribute('data-page') === targetPage) {
          tab.classList.add('active');
        } else {
          tab.classList.remove('active');
        }
      });

      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        if (link.getAttribute('data-page') === targetPage) {
          link.classList.add('bg-white/10', 'text-white', 'border-l-2', 'border-[#FF2A85]');
        } else {
          link.classList.remove('bg-white/10', 'text-white', 'border-l-2', 'border-[#FF2A85]');
        }
      });

      // Sync URL
      const newHash = targetPage === 'home' ? '#/' : `#/${targetPage}`;
      if (window.location.hash !== newHash) {
        try {
          window.history.pushState({ page: targetPage }, '', newHash);
        } catch(e) {
          window.location.hash = newHash;
        }
      }

      // Update page title
      const pName = (typeof portfolioData !== 'undefined' && portfolioData.personal.name) ? portfolioData.personal.name : 'Gajanan Sanjay Kadam';
      const pageTitleCapitalized = targetPage.charAt(0).toUpperCase() + targetPage.slice(1);
      document.title = targetPage === 'home' 
        ? `${pName} | Second-Year CSE Student | SSGMCE Shegaon`
        : `${pageTitleCapitalized} | ${pName} | SSGMCE Shegaon`;

      // Smooth scroll to top
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Re-trigger icon rendering
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }

    window.addEventListener('popstate', () => navigateTo(getRouteFromUrl()));
    window.addEventListener('hashchange', () => navigateTo(getRouteFromUrl()));

    // -------------------------------------------------------------------------
    // 2. DATA INITIALIZATION & DYNAMIC BINDINGS
    // -------------------------------------------------------------------------
    document.addEventListener('DOMContentLoaded', () => {
      navigateTo(getRouteFromUrl());

      if (typeof portfolioData !== 'undefined') {
        const p = portfolioData.personal;
        const c = portfolioData.contact;

        if (p.name) {
          const nameElems = ['nav-name', 'hero-name', 'hero-avatar-name'];
          nameElems.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.textContent = p.name;
          });
        }

        if (p.initials) {
          const initEl = document.getElementById('nav-initials');
          if (initEl) initEl.textContent = p.initials;
        }

        // Profile Avatar Hydration
        const heroImg = document.getElementById('hero-profile-img');
        const heroFallback = document.getElementById('hero-profile-fallback');
        const savedAvatar = localStorage.getItem('user_custom_avatar') || p.avatarUrl;

        if (savedAvatar && heroImg && heroFallback) {
          heroImg.src = savedAvatar;
          heroImg.classList.remove('hidden');
          heroFallback.classList.add('hidden');
        }

        // Avatar file upload handler
        const avatarInput = document.getElementById('avatar-file-input');
        if (avatarInput) {
          avatarInput.addEventListener('change', (e) => {
            const file = e.target.files && e.target.files[0];
            if (file) {
              const reader = new FileReader();
              reader.onload = (event) => {
                const dataUrl = event.target.result;
                if (heroImg && heroFallback) {
                  heroImg.src = dataUrl;
                  heroImg.classList.remove('hidden');
                  heroFallback.classList.add('hidden');
                }
                try {
                  localStorage.setItem('user_custom_avatar', dataUrl);
                } catch(err) {}
                showToast("Profile photograph updated successfully!");
              };
              reader.readAsDataURL(file);
            }
          });
        }
      }

      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }

      initSparkCanvas();
      initTypewriter();
      initMobileMenu();
      initSkillFilters();
    });

    // -------------------------------------------------------------------------
    // 3. TYPEWRITER / WORD CYCLER ANIMATION
    // -------------------------------------------------------------------------
    function initTypewriter() {
      const el = document.getElementById('hero-typewriter');
      if (!el) return;

      const words = [
        "Second-Year CSE Student @ SSGMCE",
        "Ex-Navodayan (JNV Parbhani)",
        "C Programmer & Algorithmic Thinker",
        "Frontend & Web Development Enthusiast",
        "Problem Solver (Sem 1: 8.14 | Sem 2: 8.32 SGPA)"
      ];

      let wordIndex = 0;
      let charIndex = 0;
      let isDeleting = false;
      const typeSpeed = 65;
      const deleteSpeed = 35;
      const delayBetweenWords = 1800;

      function type() {
        const currentWord = words[wordIndex];
        
        if (isDeleting) {
          el.textContent = currentWord.substring(0, charIndex - 1);
          charIndex--;
        } else {
          el.textContent = currentWord.substring(0, charIndex + 1);
          charIndex++;
        }

        let currentSpeed = isDeleting ? deleteSpeed : typeSpeed;

        if (!isDeleting && charIndex === currentWord.length) {
          currentSpeed = delayBetweenWords;
          isDeleting = true;
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          currentSpeed = 400;
        }

        setTimeout(type, currentSpeed);
      }

      setTimeout(type, 800);
    }

    // -------------------------------------------------------------------------
    // 4. SPARK CONSTELLATION CANVAS ENGINE (Sunset Orange & Cyber Pink)
    // -------------------------------------------------------------------------
    function initSparkCanvas() {
      const canvas = document.getElementById('spark-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let width = (canvas.width = window.innerWidth);
      let height = (canvas.height = window.innerHeight);

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      const count = Math.min(Math.floor(width / 40), 38);
      const sparks = [];
      const mouse = { x: -1000, y: -1000, radius: 140 };

      window.addEventListener('mousemove', (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      });

      window.addEventListener('mouseleave', () => {
        mouse.x = -1000;
        mouse.y = -1000;
      });

      class SparkNode {
        constructor() {
          this.x = Math.random() * width;
          this.y = Math.random() * height;
          this.vx = (Math.random() - 0.5) * 0.45;
          this.vy = (Math.random() - 0.5) * 0.45;
          this.radius = Math.random() * 2.2 + 1;
          this.isPink = Math.random() > 0.5;
        }

        update() {
          this.x += this.vx;
          this.y += this.vy;

          if (this.x < 0 || this.x > width) this.vx = -this.vx;
          if (this.y < 0 || this.y > height) this.vy = -this.vy;

          const dx = mouse.x - this.x;
          const dy = mouse.y - this.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < mouse.radius) {
            const force = (mouse.radius - dist) / mouse.radius;
            this.x -= (dx / dist) * force * 1.2;
            this.y -= (dy / dist) * force * 1.2;
          }
        }

        draw() {
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
          ctx.fillStyle = this.isPink ? 'rgba(255, 42, 133, 0.85)' : 'rgba(255, 107, 53, 0.85)';
          ctx.shadowBlur = 8;
          ctx.shadowColor = this.isPink ? '#FF2A85' : '#FF6B35';
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }

      for (let i = 0; i < count; i++) {
        sparks.push(new SparkNode());
      }

      let animId;
      function animate() {
        ctx.clearRect(0, 0, width, height);

        for (let i = 0; i < sparks.length; i++) {
          sparks[i].update();
          sparks[i].draw();

          for (let j = i + 1; j < sparks.length; j++) {
            const dx = sparks[i].x - sparks[j].x;
            const dy = sparks[i].y - sparks[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);

            if (dist < 120) {
              ctx.beginPath();
              ctx.moveTo(sparks[i].x, sparks[i].y);
              ctx.lineTo(sparks[j].x, sparks[j].y);
              const opacity = (1 - dist / 120) * 0.25;
              ctx.strokeStyle = sparks[i].isPink 
                ? `rgba(255, 42, 133, ${opacity})` 
                : `rgba(255, 107, 53, ${opacity})`;
              ctx.lineWidth = 0.8;
              ctx.stroke();
            }
          }
        }

        animId = requestAnimationFrame(animate);
      }

      animate();

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(animId);
        else animId = requestAnimationFrame(animate);
      });
    }

    // -------------------------------------------------------------------------
    // 5. MOBILE MENU & FILTER LOGIC
    // -------------------------------------------------------------------------
    function initMobileMenu() {
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (!menuBtn || !mobileMenu) return;

      menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMobileMenu();
      });

      document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target) && !menuBtn.contains(e.target) && !mobileMenu.classList.contains('hidden')) {
          toggleMobileMenu(false);
        }
      });
    }

    function toggleMobileMenu(forceState) {
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (!menuBtn || !mobileMenu) return;

      const isCurrentlyOpen = !mobileMenu.classList.contains('hidden');
      const shouldOpen = typeof forceState === 'boolean' ? forceState : !isCurrentlyOpen;

      if (shouldOpen) {
        mobileMenu.classList.remove('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
        menuBtn.innerHTML = '<i data-lucide="x" class="w-5 h-5"></i>';
      } else {
        mobileMenu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.innerHTML = '<i data-lucide="menu" class="w-5 h-5"></i>';
      }
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function initSkillFilters() {
      const btns = document.querySelectorAll('.skill-filter-btn');
      const groups = document.querySelectorAll('.skill-card-group');

      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          btns.forEach(b => {
            b.classList.remove('bg-[#FF6B35]', 'text-white');
            b.classList.add('text-[#C4B5CD]');
          });
          btn.classList.add('bg-[#FF6B35]', 'text-white');
          btn.classList.remove('text-[#C4B5CD]');

          const filter = btn.getAttribute('data-filter');
          groups.forEach(group => {
            if (filter === 'all' || group.getAttribute('data-category') === filter) {
              group.style.display = 'block';
            } else {
              group.style.display = 'none';
            }
          });
        });
      });
    }

    // -------------------------------------------------------------------------
    // 6. TOAST, CLIPBOARD & MODALS
    // -------------------------------------------------------------------------
    function showToast(message) {
      const toast = document.getElementById('toast');
      const msg = document.getElementById('toast-message');
      if (!toast || !msg) return;

      msg.textContent = message;
      toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
      }, 3500);
    }

    function copyEmailToClipboard() {
      const email = 'gajanan.kadam2004@gmail.com';
      navigator.clipboard.writeText(email).then(() => {
        showToast(`Copied ${email} to clipboard!`);
      }).catch(() => {
        showToast(`Email: ${email}`);
      });
    }

    function copyPhoneToClipboard() {
      const phone = '9309241434';
      navigator.clipboard.writeText(phone).then(() => {
        showToast(`Copied ${phone} to clipboard!`);
      }).catch(() => {
        showToast(`Phone: ${phone}`);
      });
    }

    function openResumeModal() {
      const modal = document.getElementById('resume-modal');
      if (modal) modal.classList.remove('hidden');
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function closeResumeModal() {
      const modal = document.getElementById('resume-modal');
      if (modal) modal.classList.add('hidden');
    }

    function openAIArchitectureModal() {
      const modal = document.getElementById('ai-modal');
      if (modal) modal.classList.remove('hidden');
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function closeAIArchitectureModal() {
      const modal = document.getElementById('ai-modal');
      if (modal) modal.classList.add('hidden');
    }

    // Contact form handler
    function handleFormSubmit(event) {
      event.preventDefault();
      const name = document.getElementById('form-name').value;
      const email = document.getElementById('form-email').value;
      const subject = document.getElementById('form-subject').value;
      const message = document.getElementById('form-message').value;

      const targetEmail = 'gajanan.kadam2004@gmail.com';
      const mailtoUrl = `mailto:${targetEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent("From: " + name + " (" + email + ")\n\n" + message)}`;

      const successBox = document.getElementById('form-success-box');
      const launchBtn = document.getElementById('launch-email-btn');

      if (successBox) {
        successBox.classList.remove('hidden');
        if (launchBtn) {
          launchBtn.onclick = () => { window.location.href = mailtoUrl; };
        }
        showToast("Message recorded! Click 'Launch in Mail Client' to dispatch.");
      }

      event.target.reset();
    }

    function sendViaMailClient() {
      const name = (document.getElementById('form-name') && document.getElementById('form-name').value) || 'Visitor';
      const email = (document.getElementById('form-email') && document.getElementById('form-email').value) || '';
      const subject = (document.getElementById('form-subject') && document.getElementById('form-subject').value) || 'Portfolio Inquiry';
      const message = (document.getElementById('form-message') && document.getElementById('form-message').value) || '';

      const mailtoUrl = `mailto:gajanan.kadam2004@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent("From: " + name + " (" + email + ")\n\n" + message)}`;
      window.location.href = mailtoUrl;
    }
  </script>
</body>
</html>
